		"prefix": "adjacency_prov",
		"body": [
			"FromProvID;ToProvID;sea|land|impassable|canal;ThroughProvID;Data;Comment"
		],
		"description": "Defining Adjacencies: 'Data' will always be '0' unless it is a canal; for impassable, use '0;0'"
