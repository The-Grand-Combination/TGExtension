	"Province Definitions": {
		"prefix": "definition_prov",
		"body": [
			"ProvID;RED;GREEN;BLUE;provName;x"
		],
		"description": "Defining Provinces: remember to define it in continent.txt, climate.txt, regions.txt, add prov + pop history files in history/provinces and history/pops, increase max_provinces by 1 for every new prov in default.map, and add it to the all_land_provs region"
	},
