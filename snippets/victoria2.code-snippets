            "}",
            "party_loyalty = {",
            "    ideology = ${12:ideology2}",
            "    loyalty_value = ${13:value5}",
            "}",
            "",
            "state_building = {",
            "    level = 2",
            "    building = ${14:factory}",
            "    upgrade = ${15:value6}",
            "}",
            ""
        ],
        "description":"A template for pre-existing provinces at the start of the game. Only for use inside the history files."
    },

