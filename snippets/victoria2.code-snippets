        "body": [
            "owner = ${1:TAG}",
            "controller = ${1:TAG}",
            "add_core = ${1:TAG}",
            "trade_goods = ${2:good}",
            "life_rating = ${3:value}",
            "terrain = ${4:terrain}",
            "is_slave = ${5:yes_no}",
            "colonial = ${6:colonial_level}",
            "",
            "fort = ${7:value1}",
            "naval_base = ${8:value2}",
            "railroad = ${9:value3}",
            "",
            "party_loyalty = {",
            "    ideology = ${10:ideology}",
