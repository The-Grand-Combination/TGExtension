    "Casus Belli - Defining": {
        "prefix": "casus_belli_defining",
        "body": [
            "${1:CB_NAME} = {",
            "    sprite_index = ${2:SPRITE_INDEX}",
            "    is_triggered_only = yes",
            "    months = 12",
            "    crisis = no",
            "    constructing_cb = no",
            "",
            "    badboy_factor = 0",
            "    prestige_factor = 0.5",
            "    peace_cost_factor = 35",
            "    penalty_factor = 1",
            "",
            "    break_truce_prestige_factor = 1",
            "    break_truce_infamy_factor = 1",
            "    break_truce_militancy_factor = 1",
            "    truce_months = 48",
            "",
            "    good_relation_prestige_factor = 1",
            "    good_relation_infamy_factor = 1",
            "    good_relation_militancy_factor = 1",
            "",
            "    always = no",
            "",
            "    can_use = {} # This part must be empty, or the CB will cause lag",
            "",
            "    # po_effects",
            "",
            "    on_po_accepted = {",
            "        # effects",
            "    }",
            "",
            "    on_add = {}",
            "",
            "    war_name = ${3:WAR_NAME}",
            "}"
        ],
        "description": "A template for a casus belli that is only ever given out by events/decisions or in scripted wars. Causes minimal lag."
    },

    "Renaming Format - Province Only": {
        "prefix": "rename_prov",
        "body": [
            "any_country = {",
            "    limit = {",
            "        owns = ${1:ProvID}",
            "        is_culture_group = ${2:Culture_Group}",
            "        primary_culture = ${3:Primary_Culture}",
            "    }",
            "    ${1} = { change_province_name = \"${4:Rename}\" }",
            "}"
        ],
        "description": "Standard IF emulation for renames for provs in the renaming event."
    },

    "Renaming Format - Province + State": {
        "prefix": "rename_capital",
        "body": [
            "any_country = {",
            "    limit = {",
            "        owns = ${1:ProvID}",
            "        is_culture_group = ${2:Culture_Group}",
            "        primary_culture = ${3:Primary_Culture}",
            "    }",
            "    ${1} = {",
            "        change_province_name = \"${4:Rename}\"",
            "        state_scope = { change_region_name = \"${5:Region_Rename}\" }",
            "    }",
            "}"
        ],
        "description": "Standard IF emulation for renames for capital provs in the renaming event."
    },

    "Song": {
        "prefix": "song",
        "body": [
            "song = {",
            "    name = \"$1\"",
            "    chance = {",
            "        modifier = { factor = $2 }",
            "    }",
            "}"
        ],
        "description": "Effect that sets up the chances for a specific piece of music to play."
    },

    "Song Modifier": {
        "prefix": "modifier_song",
        "body": [
            "modifier = { factor = ${1:1} $2 }"
        ],
        "description": "Effect that adds a modifier to the chance of a specific piece of music playing."
    }
}