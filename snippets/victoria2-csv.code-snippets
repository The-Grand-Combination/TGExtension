{ 
	"Event Localization": {
		"prefix": "event_localization_country",
		"body": [
			"EVTDESC${1:ID};${2:Localization};;;;;;;;;;;;;x",
			"EVTNAME${1};${3:Localization};;;;;;;;;;;;;x",
			"EVTOPTA${1};${4:Localization};;;;;;;;;;;;;x",
			"EVTOPTB${1};${5:Localization};;;;;;;;;;;;;x"
		],
		"description": "Localization for country events"
	},
	"Event Option Localization": {
		"prefix": "option_event_localization",
		"body": [
			"EVTOPT${1|C,D,E|};${2:Localization};;;;;;;;;;;;;x"
