{
	"scopeName": "source.csv",
	"fileTypes": ["csv"],
	"name": "Semicolon CSV",
	"patterns": [
	  {
		"name": "text.csv",
		"patterns": [
		  {
		    "name": "location.codesnippet.paradox",
		    "match": "\\b(ProvID|FromProvID|ToProvID)\\b"
		  },
		  {
			"name": "comment_sign.paradox",
			"begin": "#",
			"captures": {
				"1": {
				"name": "comment.paradox"
				}
			},
			"end": "$\\n?"
		  },
		  {
			"name": "variable.parameter.csv.key",
			"match": "^[^;]+(?=;)",
			"captures": {
			  "0": {
				"name": "variable.parameter.csv.key"
			  }
			}
		  },
		  {
			"name": "variable.parameter.csv.text",
			"match": "(?<=^[^;]+;)[^;]*(?=;|$)",
			"captures": {
			  "0": {
				"name": "variable.parameter.csv.text"
			  }
			}
		  },
		  {
			"name": "variable.parameter.csv.gray",
			"match": "[^;][^;](.*)",
			"captures": {
			  "0": {
				"name": "variable.parameter.csv.gray"
			  }
			}
		  },
		  {
			"name": "variable.parameter.csv.gray2",
			"match": "[.;][.;](.*)",
			"captures": {
			  "0": {
				"name": "variable.parameter.csv.gray"
			  }
			}
		  }
		]
	  }
	]
}
