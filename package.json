{
  "name": "victorian-tools",
  "displayName": "Victorian Tools",
  "description": "Tooling for Victoria 2 mod files: a language server that parses Paradox script and validates it inline.",
  "version": "4.0.0",
  "publisher": "TGCModdingTeam",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Grand-Combination/TGExtension.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.mod",
    "workspaceContains:common/cultures.txt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "victoria2",
        "aliases": [
          "Victoria 2 Script",
          "Paradox Script"
        ],
        "extensions": [
          ".gui",
          ".gfx",
          ".sfx",
          ".mod"
        ],
        "filenamePatterns": [
          "**/events/**/*.txt",
          "**/decisions/**/*.txt",
          "**/common/**/*.txt",
          "**/poptypes/**/*.txt",
          "**/technologies/**/*.txt",
          "**/inventions/**/*.txt",
          "**/news/**/*.txt",
          "**/history/**/*.txt",
          "**/units/**/*.txt",
          "**/map/**/*.txt",
          "**/map/default.map",
          "**/interface/**/*.txt",
          "**/localisation/**/*.txt",
          "**/battleplans/**/*.txt",
          "**/tutorial/**/*.txt",
          "**/script/**/*.txt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "victoria2-csv",
        "aliases": [
          "Victoria 2 CSV"
        ],
        "filenamePatterns": [
          "**/localisation/**/*.csv",
          "**/map/**/*.csv"
        ],
        "configuration": "./csv-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "victoria2",
        "scopeName": "source.victoria2",
        "path": "./syntaxes/victoria2.tmLanguage.json"
      },
      {
        "language": "victoria2-csv",
        "scopeName": "source.victoria2csv",
        "path": "./syntaxes/victoria2csv.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "victoria2",
        "path": "./snippets/victoria2.code-snippets"
      },
      {
        "language": "victoria2-csv",
        "path": "./snippets/victoria2-csv.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "victorian-tools.restartServer",
        "title": "Restart Language Server",
        "category": "Victorian Tools"
      },
      {
        "command": "victorian-tools.generateFullReport",
        "title": "Generate Full Report",
        "category": "Victorian Tools",
        "icon": "$(checklist)"
      },
      {
        "command": "victorian-tools.generateMapReport",
        "title": "Generate Map Report",
        "category": "Victorian Tools",
        "icon": "$(map)"
      },
      {
        "command": "victorian-tools.enforceColormaps",
        "title": "Enforce Colormaps",
        "category": "Victorian Tools",
        "icon": "$(symbol-color)"
      },
      {
        "command": "victorian-tools.launchGame",
        "title": "Launch Game",
        "category": "Victorian Tools",
        "icon": "$(play)"
      },
      {
        "command": "victorian-tools.openSettings",
        "title": "Open Settings",
        "category": "Victorian Tools",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "victorianTools",
          "title": "Victorian Tools",
          "icon": "images/vicIItools.png"
        }
      ]
    },
    "views": {
      "victorianTools": [
        {
          "id": "victorianTools.actions",
          "name": "Actions",
          "icon": "images/vicIItools.png",
          "contextualTitle": "Victorian Tools"
        }
      ]
    },
    "configuration": {
      "title": "Victorian Tools",
      "properties": {
        "victorianTools.validation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline validation of Victoria 2 script files."
        },
        "victorianTools.validation.delay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "markdownDescription": "Milliseconds of typing pause before a changed file is revalidated. `0` validates on every keystroke."
        },
        "victorianTools.index.rebuildDelay": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 10000,
          "markdownDescription": "Milliseconds to wait after mod files change on disk before rebuilding the identifier index of the mods they belong to."
        },
        "victorianTools.index.onStartup": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Index every mod in the workspace when the server starts, so mod-wide errors (duplicate identifiers) appear without opening a file. Turn off to index a mod only when one of its files is opened."
        },
        "victorianTools.gamePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The Victoria 2 install folder (the one holding `mod/`, `common/` and `map/`). Leave empty to detect it above the workspace folder. Mods are read on top of the game files they do not `replace_path`. Set from **Settings** in the Victorian Tools side bar."
        },
        "victorianTools.activeMods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "`name`s (from their `.mod` files) of the mods and submods being worked on, any combination. Their files are validated against the whole stack, in load order (dependencies first): game files, then each selected mod. Empty: every mod is read with its dependencies only. Set from **Settings** in the Victorian Tools side bar."
        },
        "victorianTools.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Victorian Tools language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "mocha": "^12.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.2.0"
  }
}
