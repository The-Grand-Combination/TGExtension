{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder:Victorian Tools V2}"
      ],
      "outFiles": [
        "${workspaceFolder:Victorian Tools V2}/dist/**/*.js"
      ],
      "preLaunchTask": "watch"
    },
    {
      "name": "Attach to Server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder:Victorian Tools V2}/dist/**/*.js"
      ]
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder:Victorian Tools V2}",
        "--extensionTestsPath=${workspaceFolder:Victorian Tools V2}/out/test/suite/index"
      ],
      "outFiles": [
        "${workspaceFolder:Victorian Tools V2}/out/**/*.js",
        "${workspaceFolder:Victorian Tools V2}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: watch-tests"
    }
  ],
  "compounds": [
    {
      "name": "Client + Server",
      "configurations": ["Run Extension", "Attach to Server"]
    }
  ]
}
